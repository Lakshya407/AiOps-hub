# Copy to .env for local development. Never commit real keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Comma-separated admin emails (client-side role resolution; works before migration 0007).
# Example: VITE_ADMIN_EMAILS=admin@example.com,owner@example.com
VITE_ADMIN_EMAILS=

