{
  "name": "aiops-learning-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Personal AIOps Learning Hub - six-month roadmap, tracking, notes, docs, projects, analytics",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0 || true",
    "typecheck": "tsc --noEmit",
    "seed:check": "node scripts/verify-seed.mjs || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.51.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.25.1",
    "recharts": "^2.12.7",
    "rehype-sanitize": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
